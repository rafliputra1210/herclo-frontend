Options -MultiViews
RewriteEngine On

# Izinkan file statis langsung
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Fallback untuk dynamic route articles/[slug] (CSR)
RewriteCond %{REQUEST_URI} ^/articles/[^/]+/?$
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^articles/[^/]+/?$ /articles/placeholder/index.html [L]

# Semua route lain ke index.html
RewriteRule ^ index.html [L]
